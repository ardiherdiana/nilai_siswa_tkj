APP_NAME="Nilai Siswa TKJ & Supervisi Guru"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Basis data Nilai Siswa TKJ & Supervisi Guru.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nilai_siswa_tkj
DB_USERNAME=root
DB_PASSWORD=
# Zona waktu koneksi = APP_TIMEZONE (Asia/Jakarta), supaya kolom tanggal-waktu konsisten.
DB_TIMEZONE=+07:00

# Sesi dan cache memakai berkas, antrean sync: tidak ada tabel framework.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Isi true di produksi (HTTPS) supaya cookie sesi tidak pernah lewat HTTP.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

# Wajib true di semua environment: mencegah tombol back browser menampilkan halaman lama (formulir masuk basi
# atau dasbor akun lain) dari cache riwayat Inertia.
INERTIA_ENCRYPT_HISTORY=true

VITE_APP_NAME="${APP_NAME}"
